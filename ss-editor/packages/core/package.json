{
  "name": "@scada-editor/core",
  "version": "0.1.0",
  "description": "SCADA 编辑器核心库",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": {
      "import": "./dist/style.css"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@scada-editor/plugin-sdk": "workspace:*",
    "@types/uuid": "^11.0.0",
    "konva": "^9.2.0",
    "pinia": "^2.1.6",
    "uuid": "^13.0.0",
    "vue": "^3.3.4",
    "vue-i18n": "^9.2.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "1.6.1",
    "typescript": "^5.0.2",
    "vite": "^5.0.0",
    "vitest": "^1.2.0"
  }
}
