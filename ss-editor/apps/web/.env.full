# Smart SCADA - integrated mode (full)
# Includes all capabilities of ss-scada + ss-data
# ⚠️  This file is for production builds only; do not include any debug switches (e.g. VITE_DEBUG_SKIP_AUTH)
#     Set debug switches in .env.development instead
#     See: jwt-auth.guard.ts isDevMode() — mock tokens are not recognized in production
VITE_PRODUCT_MODE=full
VITE_API_BASE_URL=http://localhost:4000
VITE_WS_URL=http://localhost:4000

# Deployment base path
VITE_DEPLOY_BASE=/

# Plugin dual-mode config
VITE_PLUGIN_MODE=mixed
VITE_PLUGIN_REGISTRY_URL=/plugins
VITE_PLUGIN_PRELOAD_CATEGORIES=electric,mines,svg
