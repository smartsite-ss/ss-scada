VITE_API_BASE_URL=http://localhost:4000
VITE_WS_URL=http://localhost:4000

# ====== Debug mode: skip auth (takes effect in dev only) ======
# ⚠️  debug-mock-token is only recognized when the backend NODE_ENV !== 'production'
#     This file is not loaded in production builds
VITE_DEBUG_SKIP_AUTH=false

# ====== Deployment base path ======
# When empty (dev mode): the directory plugin loads sources via the @fs protocol
# When set (prod mode): plugins and shared deps are derived from this path
# e.g. / => plugin path=/plugins, shared dep path=/shared
VITE_DEPLOY_BASE=

# ====== Plugin dual-mode config ======
VITE_PLUGIN_MODE=mixed
VITE_PLUGIN_REGISTRY_URL=/plugins

# Preloaded industry categories (comma-separated)
# Note: only list categories with deployMode=directory (see packages/plugins/categories.json)
# bundled categories' widgets are already compiled into the main bundle; do not list them here, otherwise it requests a non-existent directory manifest
VITE_PLUGIN_PRELOAD_CATEGORIES=electric,mines,svg
