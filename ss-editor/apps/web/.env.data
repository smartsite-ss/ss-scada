# Smart SCADA - ss-data split mode
# Data platform / system management only
VITE_PRODUCT_MODE=data
VITE_API_BASE_URL=http://localhost:4000
VITE_WS_URL=http://localhost:4000

# dev server port: data mode is fixed to 5175; do NOT use 5173 (full shell port, includes /preview)
VITE_PORT=5175

# Deployment base path (a sub-path can be used in split mode)
VITE_DEPLOY_BASE=/

# Plugin mode (data mode does not need graphic plugins)
VITE_PLUGIN_MODE=off

# Cross-product jump URL (scada-mode frontend address, used to jump from data to the scada editor)
VITE_SCADA_BASE_URL=http://localhost:5174
