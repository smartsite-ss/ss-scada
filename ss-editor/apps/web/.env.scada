# Smart SCADA - ss-scada split mode
# Config editor / runtime only
VITE_PRODUCT_MODE=scada
VITE_API_BASE_URL=http://localhost:4100
VITE_WS_URL=http://localhost:4100

# dev server port: scada mode is fixed to 5174; do NOT use 5173 (full shell port, includes /preview)
VITE_PORT=5174

# Deployment base path (a sub-path can be used in split mode)
VITE_DEPLOY_BASE=/

# Plugin dual-mode config
VITE_PLUGIN_MODE=mixed
VITE_PLUGIN_REGISTRY_URL=/plugins
VITE_PLUGIN_PRELOAD_CATEGORIES=electric,mines,3d,svg

# Cross-product jump URL (data-mode frontend address, used to jump from scada to data)
VITE_DATA_BASE_URL=http://localhost:5175
