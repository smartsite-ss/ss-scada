    "build:web:data": "cd ss-editor && pnpm build:web:data",
    "build:server": "cd ss-services/ss-node && pnpm --filter ss-node-server build",
    "build:all": "pnpm build:server && pnpm build:web:full && pnpm build:web:scada && pnpm build:web:data"
