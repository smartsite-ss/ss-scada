# ===========================================
# Smart SCADA - ss-node 环境配置模板
# ===========================================
# 使用方式:
#   开发环境: cp .env.example .env.dev （修改开发参数）
#   生产环境: cp .env.example .env.pro （修改生产参数）
#   自动加载: 根据 APP_ENV 环境变量自动选择 .env.dev 或 .env.pro
# ===========================================

# --- 应用配置 ---
# 运行环境: dev | pro
APP_ENV=dev
# 运行模式: development | production
NODE_ENV=development
# 服务端口
PORT=4000

# --- Node.js 运行时配置 ---
# libuv 线程池大小（默认 4，增大可缓解并发 SQLite 查询阻塞）
# 注意：必须在 Node 进程启动前设置，dotenv 读取时线程池已初始化，无效
# 正确方式：在启动脚本中 set UV_THREADPOOL_SIZE=8，或系统环境变量
# UV_THREADPOOL_SIZE=8

# --- 数据库配置 (SQLite 默认) ---
# 数据库类型: sqlite | mysql
DB_TYPE=sqlite
# SQLite 数据文件路径 (相对/绝对路径)
DATABASE_PATH=./data/db/ss-node.db

# --- MySQL 配置 (仅 DB_TYPE=mysql 时生效) ---
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_USER=root
# DATABASE_PASSWORD=
# DATABASE_NAME=smart_scada

# --- InfluxDB 配置 (时序数据库, 可选) ---
# 用于存储设备历史数据, 未配置则降级为仅 SQLite
# INFLUXDB_URL=http://localhost:8086
# INFLUXDB_TOKEN=
# INFLUXDB_ORG=ss-org
# INFLUXDB_BUCKET=ss_node_data
# INFLUXDB_BATCH_SIZE=1000
# INFLUXDB_FLUSH_INTERVAL=5000

# --- 时序存储引擎路由 (可选) ---
# 默认引擎：influxdb2（默认值）/ influxdb3 / tdengine / sqlite / mysql
# 存量别名 'influxdb' 自动归一化为 'influxdb2'；支持项目级覆盖（setProjectEngine）
# STORAGE_DEFAULT_ENGINE=influxdb2

# --- InfluxDB 3 Core 配置 (时序数据库, 可选) ---
# 独立数据库服务（如 ss-influxdb3 容器，独立端口），与 InfluxDB 2 平级并存
# INFLUXDB3_URL=http://localhost:8181
# INFLUXDB3_TOKEN=
# INFLUXDB3_DATABASE=ss-node-data
# 保留期建库时设定（v3 特性：建库后不可修改），如 365d
# INFLUXDB3_RETENTION_PERIOD=365d

# --- TDengine 配置 (时序数据库, 可选) ---
# 独立数据库服务（如 ss-tdengine 容器，:6041 为 taosAdapter HTTP 端口）
# TDENGINE_URL=http://localhost:6041
# TDENGINE_USER=root
# TDENGINE_PASSWORD=taosdata
# TDENGINE_DATABASE=ss_node_data
# 保留期 KEEP 建库时设定（单位：天）
# TDENGINE_KEEP_DAYS=365

# --- 数据目录配置 ---
# 数据根目录
DATA_DIR=./data
# 日志目录
LOG_DIR=${DATA_DIR}/logs
# 工程文件目录（项目资料存放位置）
# dev: ../../ss-project（指向 ss-v7 根目录下的 ss-project）
# pro: ./data/projects（部署目录下的 data/projects）
PROJECTS_DIR=${DATA_DIR}/projects

# 项目数据库模式：isolated（每个项目独立DB） | unified（共用全局DB）
PROJECT_DB_MODE=isolated

# SQL 初始化脚本目录（相对于 process.cwd()，含 init-system-db.sql / init-event-db.sql）
# dev: ../../data/init → ss-node/data/init/ ; prod: ../../data/init → ss-run/ss/data/init/
PROJECT_DB_INIT_DIR=../../data/init
# 模板目录
TEMPLATES_DIR=${DATA_DIR}/templates
# 字典目录
DICTS_DIR=${DATA_DIR}/dicts
# 图库目录（图元图片资源：PNG/SVG/GIF）
IMAGES_DIR=${DATA_DIR}/images
# 实时数据缓存目录
REALTIME_DATA_DIR=${DATA_DIR}/realtime

# --- JWT 认证配置 ---
# 签名密钥 (生产环境必须修改！)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# Token 有效期 (如 7d, 24h, 3600s)
JWT_EXPIRES_IN=7d
# Access Token 有效期 (默认 15m)
JWT_ACCESS_EXPIRES_IN=15m
# Refresh Token 有效期 (默认 7d)
JWT_REFRESH_EXPIRES_IN=7d

# --- 微信登录配置 (可选) ---
# 总开关：关闭时后端不注册 WechatAuthModule，前端不显示微信登录入口
WECHAT_LOGIN_ENABLED=false
# Mock 模式：true 时返回固定假 openid，无需真实凭证（仅限开发调试）
WECHAT_MOCK=true
# Mock 模式固定 openid（配合 WECHAT_MOCK=true）
WECHAT_MOCK_DEFAULT_OPENID=mock_wechat_user_001
# 开放平台网站应用（Web 扫码登录）凭证，真实凭证建议写入 .env.local（不入库）
WECHAT_APPID=
WECHAT_SECRET=
# 小程序凭证（小程序授权登录，未配置时回退 WECHAT_APPID/WECHAT_SECRET）
# 注意：SECRET 属于机密，应写入 .env.local（已 gitignore），严禁提交到仓库
WECHAT_MP_APPID=
WECHAT_MP_SECRET=

# --- Redis 配置 (可选) ---
# 用于离线消息持久化（WebSocket 重启不丢失未读消息）
# 未配置时降级为纯内存模式
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# --- 知识库配置 (FAQ) ---
# 知识库根目录（存放使用文档、操作指南、流程图等）
# 默认放置在运行目录下的 faq/ 文件夹
KB_ROOT=${DATA_DIR}/faq
# 知识库默认语言（用户未指定语言时使用）
KB_DEFAULT_LANG=zh-CN
# 知识库支持的语言列表（逗号分隔，每种语言在 KB_ROOT 下有独立目录）
KB_SUPPORTED_LANGS=zh-CN,en-US
# 是否启用 AI 自动构建知识库
KB_AI_BUILD_ENABLED=false

# --- 采集协议配置 ---
# MQTT Broker
# MQTT_BROKER_URL=mqtt://localhost:1883
# OPC UA Server
# OPCUA_SERVER_URL=opc.tcp://localhost:4840
# Modbus TCP
# MODBUS_TCP_HOST=localhost
# MODBUS_TCP_PORT=502

# --- 日志配置 ---
# 日志级别: error | warn | info | debug
LOG_LEVEL=debug
# 单文件最大大小，超过即轮转（支持 K/M/G 单位，如 10m / 100m）
LOG_MAX_SIZE=10m
# 保留最近 N 个日志文件（含 .gz 压缩文件），超出自动删除最旧
LOG_MAX_FILES=14

# --- 国际化 (i18n) 配置 ---
# 默认语言
I18N_FALLBACK_LANGUAGE=zh-CN
# 支持的语言列表 (逗号分隔)
I18N_SUPPORTED_LANGUAGES=zh-CN,en-US,zh-TW,ja-JP,ko-KR,th-TH,de-DE,fr-FR,ru-RU,pt-BR,id-ID,vi-VN,es-MX,tr-TR,ms-MY
# 开发环境热重载翻译文件
I18N_WATCH=true
# 响应头中返回语言信息
I18N_RESPONSE_HEADER=false

# --- AI Agent 配置 (P1-T01) ---
# 是否启用 AI 功能（Feature Flag 总开关）
AI_ENABLED=false
# 默认 LLM 供应商: deepseek | zhipu
AI_DEFAULT_PROVIDER=deepseek
# 任务路由策略: deepseek 适合代码生成；zhipu 适合中文问答/分析
# 路由键: codegen | chat | embedding | intent | analysis
AI_ROUTING_CODEGEN_PROVIDER=deepseek
AI_ROUTING_CHAT_PROVIDER=zhipu
AI_ROUTING_INTENT_PROVIDER=zhipu
AI_ROUTING_ANALYSIS_PROVIDER=zhipu

# --- DeepSeek API 配置 ---
# API Key (申请: https://platform.deepseek.com)
DEEPSEEK_API_KEY=
# API Base URL
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# 默认模型 (deepseek-chat | deepseek-coder | deepseek-reasoner)
DEEPSEEK_DEFAULT_MODEL=deepseek-chat
# 代码生成模型
DEEPSEEK_CODEGEN_MODEL=deepseek-coder
# 请求超时（毫秒）
DEEPSEEK_TIMEOUT=60000
# 最大重试次数
DEEPSEEK_MAX_RETRIES=3

# --- 智谱 API 配置 ---
# API Key (申请: https://open.bigmodel.cn)
ZHIPU_API_KEY=
# API Base URL
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
# 默认模型 (glm-4 | glm-4-flash | glm-4v)
ZHIPU_DEFAULT_MODEL=glm-4
# 轻量模型（用于意图解析等简单任务）
ZHIPU_LITE_MODEL=glm-4-flash
# 嵌入模型 (embedding-3 | embedding-2)
ZHIPU_EMBEDDING_MODEL=embedding-3
# 嵌入维度 (1024 | 2048)
ZHIPU_EMBEDDING_DIM=1024
# 请求超时（毫秒）
ZHIPU_TIMEOUT=60000
# 最大重试次数
ZHIPU_MAX_RETRIES=3

# --- AI 流式输出配置 (SSE) ---
# SSE 心跳间隔（毫秒，0 表示禁用）
AI_SSE_HEARTBEAT_MS=15000
# SSE 连接超时（毫秒）
AI_SSE_TIMEOUT_MS=300000
# 单次会话最大 Token 数
AI_MAX_TOKENS_PER_SESSION=8192