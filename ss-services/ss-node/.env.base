# ===========================================
# Smart SCADA - 共享基础环境变量
# 所有产品模式（full/scada/data）均加载此文件
# 路径配置保持与所有模式下数据文件位置统一
# 注意：所有依赖 ${DATA_DIR} 的路径变量必须在此文件中定义，
#       以确保 dotenv-expand 能正确展开变量（避免跨文件展开失败）
# ===========================================

# 日志级别与轮转（由 LoggerFactory 统一读取，Winston DailyRotateFile 生效）
# 默认 info：合理基础默认值；dev 模式在 .env.dev 覆盖为 warn，生产在 .env.pro 覆盖为 info
# 临时看详细日志：$env:LOG_LEVEL="debug"; pnpm --filter ss-node-server start:dev
LOG_LEVEL=info
# 单文件最大大小，超过即轮转（支持 K/M/G 单位，如 10m / 100m）
LOG_MAX_SIZE=10m
# 保留最近 N 个日志文件（含 .gz 压缩文件），超出自动删除最旧
LOG_MAX_FILES=14

# 数据库配置
DB_TYPE=sqlite

# 数据目录配置（相对于 ss-services/ss-node 目录）
# 指向 ss-run 下的统一数据目录
DATA_DIR=../../ss-run/ss/data

# 软件运行目录（基础服务软件、运行时数据存放位置）
RUN_DIR=../../ss-run/ss

# 数据库备份目录（全局数据库与项目数据库的备份存放位置）
BACKUP_DIR=${RUN_DIR}/data/_bak

# 系统健康预警阈值（百分比，超过时前端显示不同颜色）
MEMORY_WARN_PERCENT=70
MEMORY_CRITICAL_PERCENT=85
DISK_WARN_PERCENT=70
DISK_CRITICAL_PERCENT=85

# 基础服务软件根目录（Redis、InfluxDB 等便携版软件目录）
BASE_SERVICES_DIR=${RUN_DIR}/base_services

# SQLite 数据文件路径
DATABASE_PATH=${DATA_DIR}/db/ss-node.db

# MySQL 配置（仅 DB_TYPE=mysql 时生效）
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=smart_scada

# 工程目录（项目资料存放位置）
# 使用 ${DATA_DIR} 统一路径，dev/prod 模式下自动展开到正确位置
PROJECTS_DIR=${DATA_DIR}/projects

# 画布模板应用模式：reference（引用，默认）| copy（复制）
# reference: 页面记录 templateId，模板更新后可同步到关联页面
# copy:      纯快照，页面与模板无关联，模板更新不影响已创建页面
CANVAS_TEMPLATE_MODE=reference

# 项目数据库模式：isolated（每个项目独立DB） | unified（共用全局DB）
PROJECT_DB_MODE=isolated

# SQL 初始化脚本目录（基于 DATA_DIR 统一解析，指向 ss-run/ss/data/init/）
# 开发环境由 start-backend.bat Phase C 自动同步，发布时由 deploy-ss-node.ps1 拷贝
PROJECT_DB_INIT_DIR=${DATA_DIR}/init

# ── 以下路径变量依赖 ${DATA_DIR}，必须在同一文件中定义以确保正确展开 ──

# 日志目录（默认值，各模式可在 .env.{mode} 中覆盖）
LOG_DIR=${DATA_DIR}/logs

# 插件配置目录
PLUGIN_CONFIG_DIR=${DATA_DIR}/plugin-configs

# 实时数据目录
REALTIME_DATA_DIR=${DATA_DIR}/realtime

# 离线缓存 dump 目录（InfluxDB/SQLite 不可达时缓冲数据落盘位置）
OFFLINE_CACHE_DIR=${DATA_DIR}/offline_data

# 设备模板目录
TEMPLATES_DIR=${DATA_DIR}/templates

# 数据字典目录
DICTS_DIR=${DATA_DIR}/dicts

# 图库目录（图元图片资源：PNG/SVG/GIF）
IMAGES_DIR=${DATA_DIR}/images

# 知识库目录
KB_ROOT=${DATA_DIR}/faq
KB_DEFAULT_LANG=zh-CN
KB_SUPPORTED_LANGS=zh-CN,en-US
KB_AI_BUILD_ENABLED=false

# ── JWT / Redis / 基础服务 ──

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
# Access Token 有效期 (默认 15m)
JWT_ACCESS_EXPIRES_IN=15m
# Refresh Token 有效期 (默认 7d)
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Secure 标志控制
# false: Cookie 不设置 Secure 标志，HTTP/HTTPS 均可携带（适用于无 HTTPS 证书的部署环境）
# true:  Cookie 设置 Secure 标志，仅 HTTPS 下浏览器才会携带（生产环境有 HTTPS 证书时启用）
# 默认 false，确保开发环境与 HTTP 部署一致性
COOKIE_SECURE=false

# ── 数据持久化配置 ──

# 历史数据存储后端：influxdb（默认）| sqlite | mysql
# 仅写入一个后端，不与项目 SQLite 同时写入
HISTORICAL_DATA_BACKEND=influxdb

# Redis 配置（最新值写入 Redis）
REDIS_HOST=localhost
REDIS_PORT=6379

# InfluxDB 配置（时序数据存储）
# 注意：部署时 06-deploy-backend.js 步骤 6k 会自动从服务器 docker/.env 同步以下三项：
# INFLUXDB_TOKEN、INFLUXDB_ORG、INFLUXDB_BUCKET，确保与 Docker 实际初始化值一致。
# 以下为开发环境默认值，生产部署时会被覆盖。
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=ss-admin-token-2026
INFLUXDB_ORG=ss-org
INFLUXDB_BUCKET=ss_node_data
# Initial admin credentials for the first InfluxDB setup (password must be 8-72 chars)
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=SsAdmin@2026

# NanoMQ MQTT Broker 配置
NANOMQ_PORT=1883

# 是否在应用启动时自动拉起基础服务（redis、influxdb）
AUTO_START_BASE_SERVICES=false

# ── 设备管理 — 定时任务间隔配置（单位：毫秒）──

# 心跳检测间隔：设备离线判定周期（默认 5000）
DEVICE_HEARTBEAT_CHECK_INTERVAL_MS=5000
# 连接心跳间隔：活动连接空闲检查周期（默认 30000）
DEVICE_CONNECTION_HEARTBEAT_INTERVAL_MS=30000
# 状态持久化间隔：脏标记批量写入 system.db 的周期（默认 30000）
DEVICE_PERSIST_INTERVAL_MS=30000
# 自动重连间隔：设备断线后重试周期（默认 30000）
DEVICE_AUTO_RECONNECT_INTERVAL_MS=30000
# 仿真数据生成默认间隔：设备级可覆盖（默认 1000）
DEVICE_SIMULATION_DEFAULT_INTERVAL_MS=1000
# 数据归档默认间隔：cron 解析失败的 fallback（默认 300000，即 5 分钟）
DEVICE_ARCHIVE_DEFAULT_INTERVAL_MS=300000

# ── 国际化 / 限流 / CORS ──

# 国际化 (i18n) 配置
I18N_FALLBACK_LANGUAGE=zh-CN
I18N_SUPPORTED_LANGUAGES=zh-CN,en-US,zh-TW,ja-JP,ko-KR,th-TH,de-DE,fr-FR,ru-RU,pt-BR,id-ID,vi-VN,es-MX,tr-TR,ms-MY
I18N_WATCH=true
I18N_RESPONSE_HEADER=false

# 限流配置
RATE_LIMIT_MAX=6000
RATE_LIMIT_WINDOW_MS=60000

# CORS 配置（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,https://tauri.localhost,http://tauri.localhost

# ── 操作日志配置 ──

# 操作日志功能开关（true 启用，false 关闭）
# 关闭后 OperationLogInterceptor 不注册，不会记录任何 HTTP 请求操作日志
OPERATION_LOG_ENABLED=true

# 操作日志保留天数（超过此天数的日志会在启动时自动清理，0 表示不自动清理）
OPERATION_LOG_RETENTION_DAYS=90

# ── AI Agent Configuration ──

# 是否启用 AI 功能（Feature Flag 总开关，启动级控制）
AI_ENABLED=true

# AI API Key 加密密钥（AES-256-GCM，必须为 32 字节以上字符串）
# 用于加密数据库中存储的 API Key，修改后已有密文将无法解密
SYSTEM_CONFIG_ENCRYPTION_KEY=ss-v7-default-encryption-key-32b

# ── 微信开放平台扫码登录（网站应用 OAuth2）──
# 功能总开关（true 启用，false 完全不注册模块 + 前端不显示扫码入口）
# 默认关闭，需启用时在 .env.dev 或 .env.pro 中覆盖为 true
WECHAT_LOGIN_ENABLED=false
# Mock 模式开关：true=开发调试（返回固定假 openid，无需真实微信资质）；false=调用真实微信 API
# 生产环境必须在 .env.pro 中覆盖为 false
WECHAT_MOCK=true
# 微信开放平台网站应用 AppID（真实模式必填，open.weixin.qq.com 创建网站应用获取）
WECHAT_APPID=
# 微信开放平台网站应用 AppSecret（真实模式必填）
WECHAT_SECRET=
# 扫码授权回调地址（必须与微信开放平台配置的授权回调域一致）
# 开发环境默认指向前端代理后的后端回调；生产部署需替换为真实域名
WECHAT_REDIRECT_URI=http://localhost:5173/api/v1/auth/wechat/callback
# Mock 模式默认 openid（开发调试用，模拟某个固定微信用户扫码）
WECHAT_MOCK_DEFAULT_OPENID=mock_wechat_user_001
