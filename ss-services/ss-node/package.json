{
  "name": "ss-node-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Smart SCADA Node.js Server - Monorepo",
  "pnpm": {
    "overrides": {
      "@nestjs/common": "10.4.22",
      "@nestjs/core": "10.4.22",
      "@nestjs/config": "3.3.0",
      "@nestjs/event-emitter": "3.0.1",
      "mysql2": "^3.9.8"
    }
  },
  "scripts": {
    "dev": "pnpm --filter ss-node-server dev",
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @ss-node/ss-sdk build && pnpm --filter @ss-node/ss-core build",
    "build:packages": "pnpm --filter @ss-node/ss-core --filter @ss-node/ss-sdk --filter @ss-node/ss-device --filter @ss-node/ss-system --filter @ss-node/ss-alarm --filter @ss-node/ss-project --filter @ss-node/ss-report --filter @ss-node/ss-script --filter @ss-node/ss-collector-sdk --filter @ss-node/ss-storage-influx --filter @ss-node/ss-i18n --filter @ss-node/ss-datatag --filter @ss-node/ss-datasource build",
    "build:all": "pnpm -r build",
    "start": "pnpm --filter ss-node-server start",
    "start:dev": "pnpm build:packages && pnpm --filter ss-node-server start:dev",
    "start:prod": "pnpm --filter ss-node-server start:prod",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,json,md}\""
  },
  "devDependencies": {
    "@nestjs/testing": "^10.3.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.41",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "5",
    "jest": "^29.7.0",
    "mockdate": "^3.0.5",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@nestjs/throttler": "^6.5.0",
    "modbus-serial": "^8.0.25",
    "mqtt": "^5.15.1",
    "node-opcua": "^2.170.1"
  }
}
