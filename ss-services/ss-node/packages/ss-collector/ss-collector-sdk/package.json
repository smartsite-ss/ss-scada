{
  "name": "@ss-node/ss-collector-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Smart SCADA Collector Plugin SDK — 采集插件开发工具包",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "create-collector-plugin": "./bin/create-plugin.ts"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./scaffold": {
      "import": "./dist/scaffold.js",
      "require": "./dist/scaffold.js",
      "types": "./dist/scaffold.d.ts"
    }
  },
  "files": [
    "dist",
    "bin",
    "!dist/plugins/.isolation/*.exe",
    "!dist/**/__tests__",
    "!dist/**/*.map",
    "!dist/**/*.spec.js"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/plugins/isolation/collector-worker.js','dist/plugins/isolation/collector-worker.js')\"",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "jest --passWithNoTests",
    "lint": "eslint src --ext .ts"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/event-emitter": "^3.0.0",
    "@ss-node/ss-core": "workspace:*",
    "winston": "^3.11.0"
  },
  "dependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
