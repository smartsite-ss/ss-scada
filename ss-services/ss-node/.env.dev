# ===========================================
# Smart SCADA - ss-node 开发环境配置
# 其余变量继承 .env.base
# ===========================================

# 应用配置
NODE_ENV=development
PORT=4000

# ── 方案 C：预览壳基地址（后端下发完整壳 URL） ──
# 调试链路：H5 dev(5174) 签票 → 壳 dev(5173, full 模式) 兑换，两端 /api 均指向本 4000 进程
# 票据为进程内存存储，签发/兑换必须同一后端进程（勿与 start-scada.bat 的 4100 混用）
SCADA_SHELL_BASE_URL=http://localhost:5173

# 日志级别 — dev 模式默认只看 warn+error，避免 info 刷屏
# 需要详细日志时命令行临时覆盖：$env:LOG_LEVEL="debug"; pnpm --filter ss-node-server start:dev
LOG_LEVEL=warn

# 数据目录配置（相对于 ss-services/ss-node 目录）
# 调试与发布共用 ss-run/ss/data 目录，确保数据库和工程数据一致
DATA_DIR=../../ss-run/ss/data

# InfluxDB 时序数据库配置
# ⚠️ InfluxDB Web UI 登录：http://127.0.0.1:8086 → 用户名 admin / 密码 admin
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=nCw3mXjEeOUt_jihlHUQxorgmE_51iJXdh-QSzwR8KsRpjZfb9AASrzB8sh0aqBBwqdrYAjSJFt_wjmcWbl4yA==
INFLUXDB_ORG=ss-org
INFLUXDB_BUCKET=ss_node_data
INFLUXDB_BATCH_SIZE=1000
INFLUXDB_FLUSH_INTERVAL=5000

# 操作日志保留天数（开发环境保留较少）
OPERATION_LOG_RETENTION_DAYS=30

# MQTT 配置
MQTT_BROKER_URL=mqtt://localhost:1883

# OPC UA 配置
OPCUA_SERVER_URL=opc.tcp://localhost:4840

# Modbus 配置
MODBUS_TCP_HOST=localhost
MODBUS_TCP_PORT=502

# ── 微信扫码登录 ──
# 功能总开关（开发者需要调试微信扫码时改为 true，配合 WECHAT_MOCK=true 使用）
WECHAT_LOGIN_ENABLED=false
