# Release uploader credentials — copy this file to bin/release.local.env
#
#   copy bin\release.local.env.example bin\release.local.env
#
# bin/release.local.env is git-ignored (see .gitignore). Never commit real tokens.
#
# GitHub: classic PAT with the "repo" scope, or a fine-grained PAT limited to
#         smartsite-ss/ss-scada with "Contents: Read and write".
#         Create at: https://github.com/settings/tokens
# Gitee : 私人令牌 with the "projects" scope.
#         Create at: https://gitee.com/profile/personal_access_tokens

GITHUB_TOKEN=
GITEE_TOKEN=
